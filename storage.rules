rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin (via custom claims)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Validate image file type
    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // Validate image size (max 5MB)
    function isValidImageSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    
    // Validate image upload
    function isValidImage() {
      return isValidImageType() && isValidImageSize();
    }
    
    // ============================================================
    // PRODUCT IMAGES
    // ============================================================
    
    match /products/{productId}/{imageFile} {
      // Anyone can read product images
      allow read: if true;
      
      // Only admins can upload product images
      allow create: if isAdmin() 
                    && isValidImage();
      
      // Only admins can update product images
      allow update: if isAdmin() 
                    && isValidImage();
      
      // Only admins can delete product images
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // CATEGORY IMAGES
    // ============================================================
    
    match /categories/{categoryId}/{imageFile} {
      // Anyone can read category images
      allow read: if true;
      
      // Only admins can upload category images
      allow create: if isAdmin() 
                    && isValidImage();
      
      // Only admins can update category images
      allow update: if isAdmin() 
                    && isValidImage();
      
      // Only admins can delete category images
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // SETTINGS/ASSETS IMAGES
    // ============================================================
    
    match /settings/{fileName} {
      // Anyone can read settings images (logos, etc.)
      allow read: if true;
      
      // Only admins can upload settings images
      allow create: if isAdmin() 
                    && isValidImage();
      
      // Only admins can update settings images
      allow update: if isAdmin() 
                    && isValidImage();
      
      // Only admins can delete settings images
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // TEMPORARY UPLOADS
    // ============================================================
    
    match /temp/{userId}/{fileName} {
      // Users can only read their own temp files
      allow read: if isAuthenticated() 
                  && request.auth.uid == userId;
      
      // Users can only upload to their own temp folder
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId
                    && isValidImage();
      
      // Users can only delete their own temp files
      allow delete: if isAuthenticated() 
                    && request.auth.uid == userId;
    }
    
    // ============================================================
    // DEFAULT DENY
    // ============================================================
    
    // Deny all other reads and writes by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
