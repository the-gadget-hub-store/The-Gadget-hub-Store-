rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin (via custom claims)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Validate email format
    function isValidEmail(email) {
      return email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }
    
    // ============================================================
    // PRODUCTS COLLECTION
    // ============================================================
    
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      
      // Only admins can create, update, or delete products
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // CATEGORIES COLLECTION
    // ============================================================
    
    match /categories/{categoryId} {
      // Anyone can read categories
      allow read: if true;
      
      // Only admins can create, update, or delete categories
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // FAVORITES COLLECTION
    // ============================================================
    
    match /favorites/{userId} {
      // Users can only read their own favorites
      allow read: if isOwner(userId);
      
      // Users can only create their own favorites document
      allow create: if isOwner(userId) 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.productIds is list;
      
      // Users can only update their own favorites
      allow update: if isOwner(userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.productIds is list;
      
      // Users can only delete their own favorites
      allow delete: if isOwner(userId);
    }
    
    // ============================================================
    // NEWSLETTER SUBSCRIBERS COLLECTION
    // ============================================================
    
    match /newsletterSubscribers/{subscriberId} {
      // No one can read subscribers (privacy protection)
      allow read: if isAdmin();
      
      // Anyone can create a subscription (validated)
      allow create: if request.resource.data.email is string
                    && isValidEmail(request.resource.data.email)
                    && request.resource.data.subscribedAt is timestamp
                    && request.resource.data.status == 'active';
      
      // Only admins can update or delete subscriptions
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // SETTINGS COLLECTION
    // ============================================================
    
    match /settings/{settingId} {
      // Anyone can read public settings
      allow read: if true;
      
      // Only admins can create, update, or delete settings
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // DEFAULT DENY
    // ============================================================
    
    // Deny all other reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
